# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and populate your credentials before running the app.
# ==============================================================================

# OpenAI API Key (Required for embeddings and LLM generation)
OPENAI_API_KEY=your_openai_api_key_here

# Cohere API Key (Required for cross-encoder reranking in Phase 2)
COHERE_API_KEY=your_cohere_api_key_here

# LLM & Embedding Model Settings
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
COHERE_RERANK_MODEL=rerank-english-v3.0

# Vector Database Storage Path
CHROMA_PERSIST_DIR=./chroma_db

# CI/CD Quality Evaluation Threshold (0.0 to 1.0)
RAGAS_FAITHFULNESS_THRESHOLD=0.80
